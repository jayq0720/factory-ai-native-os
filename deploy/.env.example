# 复制为 deploy/.env 后填写，不要提交（deploy/aliyun/deploy.sh 首次运行会自动生成并填随机密码）。
# 生产环境改用阿里云 KMS / 凭据管家注入。
# 数据库密码只用字母和数字（会拼进连接串）
POSTGRES_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
# 阿里云百炼（Qwen、DeepSeek）
DASHSCOPE_API_KEY=
# DeepSeek 官方（备用）
DEEPSEEK_API_KEY=
# mock：不调用任何模型；litellm：经 LiteLLM 调用真实模型
FOS_LLM_MODE=mock
# 文档解析（docs/ocr-mvp.md）：
#   mock     不调用模型（默认）。有文字层的 PDF / Word / Excel 仍是真实结果，扫描页为模拟
#   xiaomi   自建 Xiaomi-OCR-0（vLLM / SGLang / Ollama），FOS_OCR_BASE_URL 填它的 /v1 地址
#   qwen_vl  阿里云百炼 Qwen-VL-OCR，FOS_OCR_API_KEY 填百炼 API Key（可与 DASHSCOPE_API_KEY 相同）
FOS_OCR_MODE=mock
FOS_OCR_BASE_URL=
FOS_OCR_MODEL=
FOS_OCR_API_KEY=
FOS_OCR_CONCURRENCY=4
# 自建 Xiaomi-OCR-0（--profile gpu）：权重目录（download-model.sh 下载到这里）与显存占比
OCR_MODEL_DIR=/data/models/Xiaomi-OCR-0
OCR_GPU_MEMORY_UTILIZATION=0.6
# 网页端口（安全组只对办公网 IP 放行）
FOS_HTTP_PORT=8000
# 镜像与 pip 源。国内拉 Docker Hub 慢：用 ACR 镜像加速器（setup-host.sh 的 DOCKER_MIRROR），
# 或把下面换成自己 ACR 仓库里的地址
PYTHON_IMAGE=python:3.12-slim
PG_IMAGE=pgvector/pgvector:pg16
VLLM_IMAGE=vllm/vllm-openai:latest
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 钉钉企业内部应用（Stream 模式）。按租户命名：FOS_DINGTALK_<租户 id 大写>_*
FOS_DINGTALK_LUNENG_CLIENT_ID=
FOS_DINGTALK_LUNENG_CLIENT_SECRET=
# 机器人编码，留空则等于 CLIENT_ID
FOS_DINGTALK_LUNENG_ROBOT_CODE=
# 互动卡片模板 id（可选；不填则卡片退回 Markdown + 文字指令确认）
FOS_DINGTALK_LUNENG_CARD_TEMPLATE_ID=
